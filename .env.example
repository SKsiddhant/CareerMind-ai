# CareerMind AI - copy to .env (never commit .env)

# Google Gemini API key. The code reads GOOGLE_API_KEY (this file used to say GEMINI_API_KEY, which was ignored).
GOOGLE_API_KEY=your_gemini_api_key_here

# HuggingFace Token (only for the optional Mistral-7B LoRA fine-tuning in models/)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Database. Leave POSTGRES_HOST=localhost for local runs: if Postgres is unreachable the backend falls back
# to SQLite. Or set DATABASE_URL to a full connection string (hosted Postgres).
POSTGRES_DB=careermind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated browser origins allowed to call the API (defaults: Vite dev server and docker frontend)
# CORS_ORIGINS=http://localhost:5173,http://localhost

# Concurrent headless browsers used by the job scraper
# SCRAPER_CONCURRENCY=4

# Docker only: URL the *browser* uses to reach the backend, baked into the frontend at build time
# VITE_API_URL=http://127.0.0.1:8002
